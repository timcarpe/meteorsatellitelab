{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "build/server"
  },
  "include": ["api/**/*.ts", "src/meteor_station/server/**/*.ts"]
}
