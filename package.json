{
  "name": "meteor-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser-based Meteor satellite station for VAS Sunrise students.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm check:server && tsc --noEmit && vite build && node scripts/package-download.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/meteor_station/**/*.ts\" \"src/meteor_station/**/*.css\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"api/*.ts\" vite.config.ts",
    "format:check": "prettier --check \"src/meteor_station/**/*.ts\" \"src/meteor_station/**/*.css\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"api/*.ts\" vite.config.ts",
    "check:server": "tsc -p tsconfig.server.json && node scripts/check-server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@jtarrio/webrtlsdr": "3.0.7",
    "d3-geo": "3.1.1",
    "fflate": "0.8.3",
    "jpeg-js": "0.4.4",
    "satellite.js": "7.1.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/node": "26.6.5",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@types/w3c-web-usb": "1.0.14",
    "@vitest/coverage-v8": "5.0.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  },
  "prettier": {
    "printWidth": 88,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "packageManager": "pnpm@11.25.0"
}
